rules_version = '2';

/* ------------------------------------------------------------------
   Front Belt — Firestore security rules

   Words used here:
     partner  the business that owns a listing (salon, clinic, lodge…)
     team     Front Belt staff (role == 'admin' in users/{uid})

   This is the only thing that actually keeps the team console private.
   The page hides it and routes away from it, but a page is just text:
   anyone can read the JavaScript. These rules run on Google's servers,
   so they decide what any account is really allowed to do.

   Roles live in users/{uid}.role and can only be set from the Firebase
   console by you — no account can promote itself.
-------------------------------------------------------------------*/

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeam() {
      return signedIn() && profile().role == 'admin';
    }

    /* Fields a partner (the business that owns a listing) may change on its
       own record. Note what is NOT here: trust, published, reviewerUid.
       A partner can never approve itself or raise its own badge. */
    function partnerFieldsOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['category', 'type', 'name', 'area', 'address', 'lat', 'lng',
                  'phone', 'hours', 'services', 'note', 'registrationNo',
                  'licenceRef', 'submittedAt', 'reviewState', 'partnerNote',
                  'deniedReason', 'deniedChecks', 'reviewedAt', 'reviewStartedAt',
                  'updatedAt']);
    }

    /* A partner edit must not change what the public sees: published stays as
       it was, and the review state either stays the same or goes back into
       the queue as 'pending' (a resubmission). */
    function partnerEditOk() {
      return partnerFieldsOk()
        && request.resource.data.published == resource.data.published
        && (request.resource.data.reviewState == resource.data.reviewState
            || request.resource.data.reviewState == 'pending');
    }

    /* ---------- clinics ---------- */

    /* The collection is still called `clinics` so existing data keeps working,
       but one record is now any listing: a clinic, salon, bakery, lodge… */
    match /clinics/{clinicId} {
      /* the public site reads published listings only; the team sees all,
         and a partner can always see the record it owns */
      allow read: if resource.data.published == true
                  || isTeam()
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);

      /* TWO ways a listing can be created:
           1. the team enlists it directly
           2. a partner submits its own, unpublished, into the review queue
         Nobody can create an already-approved or already-published record. */
      allow create: if isTeam()
        || (signedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.published == false
            && request.resource.data.reviewState == 'pending');

      /* deleting a listing is a team action */
      allow delete: if isTeam();

      allow update: if isTeam()
        || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && partnerEditOk())
        /* a partner may take itself off the public site, never put itself back */
        || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published'])
            && request.resource.data.published == false)
        /* the daily status update (health listings) */
        || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'waitMinutes', 'busy', 'note', 'lastStatusAt', 'updatedAt']));

      /* status history, written when a clinic updates */
      match /updates/{updateId} {
        allow read: if true;
        allow create: if signedIn();
        allow update, delete: if isTeam();
      }
    }

    /* ---------- accounts ---------- */

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeam());

      /* a new account picks patient or provider — never admin */
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['patient', 'provider'];

      /* people may edit their own name and saved clinics, but not their role */
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      /* accounts are never deleted from the browser */
      allow delete: if false;
    }

    /* ---------- trust upgrade requests ---------- */

    match /requests/{requestId} {
      allow read: if isTeam()
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      /* approving or rejecting is a team action */
      allow update, delete: if isTeam();
    }

    /* everything else is closed */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
